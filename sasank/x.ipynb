import matplotlib.pyplot as plt
import json

# Load the JSON file (json is a built-in library)
json_file_path = "C:/Users/Lenovo/Downloads/array.json"
with open(json_file_path, "r") as f:
    data_dict = json.load(f)

# Use the list from the JSON directly
ecg_signal = data_dict["0"]
print("Loaded ECG signal length:", len(ecg_signal))

def find_peaks(signal, height, distance, prominence):
    """
    A simple implementation to find peaks in a 1D signal.
    A peak is defined as a point greater than its immediate neighbors,
    with a value at least 'height', and a prominence of at least 'prominence'.
    The 'distance' parameter enforces a minimum separation between accepted peaks.
    """
    peaks = []
    n = len(signal)
    for i in range(1, n - 1):
        # Check if the current point is a local maximum and above the height threshold.
        if signal[i] > signal[i - 1] and signal[i] > signal[i + 1] and signal[i] >= height:
            # Compute the left minimum: move left while values are lower than the candidate peak.
            left_min = signal[i]
            j = i
            while j > 0 and signal[j - 1] < signal[i]:
                left_min = min(left_min, signal[j - 1])
                j -= 1
            # Compute the right minimum: move right similarly.
            right_min = signal[i]
            j = i
            while j < n - 1 and signal[j + 1] < signal[i]:
                right_min = min(right_min, signal[j + 1])
                j += 1
            # Define the baseline as the higher of the two minima.
            base_line = max(left_min, right_min)
            curr_prominence = signal[i] - base_line
            if curr_prominence >= prominence:
                peaks.append(i)
    
    # Enforce the minimum distance between peaks (greedy approach).
    filtered_peaks = []
    for p in peaks:
        if filtered_peaks:
            if p - filtered_peaks[-1] < distance:
                # If peaks are too close, keep the one with the higher value.
                if signal[p] > signal[filtered_peaks[-1]]:
                    filtered_peaks[-1] = p
            else:
                filtered_peaks.append(p)
        else:
            filtered_peaks.append(p)
    return filtered_peaks

# Detect peaks with the given parameters.
peaks = find_peaks(ecg_signal, height=2000, distance=120, prominence=500)
print("Peaks indices:", peaks)

if len(peaks) >= 2:
    first_two_peaks = peaks[:2]
    ahh = ecg_signal[first_two_peaks[-1]]
    # Extract the segment from the first peak to slightly beyond the second peak.
    preprocess_ecg_signal = ecg_signal[peaks[0] : peaks[1] + 40]

    # Starting from the end of the segment, set values below 'ahh' to zero until a value >= ahh is encountered.
    for i in range(len(preprocess_ecg_signal) - 1, -1, -1):
        if preprocess_ecg_signal[i] >= ahh:
            break
        preprocess_ecg_signal[i] = 0

    # Plot the full ECG signal.
    plt.figure(figsize=(10, 5))
    plt.plot(ecg_signal, label="ECG Signal")
    plt.xlabel("Sample Index")
    plt.ylabel("Amplitude")
    plt.title("ECG Signal with First Two Peaks")
    plt.legend()
    plt.show()
    
    print("First two peak indices:", first_two_peaks)
    
    # Plot the preprocessed segment.
    plt.figure(figsize=(10, 5))
    plt.plot(preprocess_ecg_signal, label="bhayy")
    plt.xlabel("Sample Index")
    plt.ylabel("Amplitude")
    plt.title("Preprocessed ECG Segment")
    plt.legend()
    plt.show()
else:
    print("Not enough peaks found.")
